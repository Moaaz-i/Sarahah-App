# Copy this file to .env and fill in real values.
# NEVER commit the real .env file (it is already in .gitignore).

# --- Runtime ---
NODE_ENV=development
PORT=3000

# --- Database ---
MONGODB_URI=mongodb://127.0.0.1:27017/sarhny_dev

# --- Auth ---
# Use long random values (e.g. `openssl rand -hex 32`). Required in production.
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=sarhny-api
JWT_AUDIENCE=sarhny-app

# --- CORS (comma separated list of allowed origins) ---
CLIENT_ORIGIN=http://localhost:5173
CLIENT_URL=http://localhost:5173

# --- SMTP / Email (optional, for email verification & OTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Sar7ny <no-reply@sarhny.local>"

# --- Email Confirmation OTP Settings ---
OTP_LENGTH=6
OTP_TTL_MINUTES=15
OTP_MAX_ATTEMPTS=5

# --- Upstash Redis (Session Blacklist, Token Revocation & In-Memory Cache) ---
# Create a free Redis database at https://upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Security tunables (optional, defaults are safe) ---
BCRYPT_ROUNDS=10
PASSWORD_RESET_TTL_MINUTES=15
MAX_MESSAGES_PER_RECIPIENT_PER_DAY=20
MAX_REPORTS_PER_FINGERPRINT_PER_DAY=5
DELETED_ACCOUNT_RETENTION_DAYS=30
# Salt used to build anonymous fingerprints (rate/duplicate control only)
FINGERPRINT_SALT=

# --- Rate limiting (set RATE_LIMIT_ENABLED=false only for local debugging) ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_GLOBAL_MAX=300
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_MESSAGE_MAX=10
RATE_LIMIT_REPORT_MAX=10
RATE_LIMIT_PASSWORD_MAX=5

# --- Google OAuth 2.0 / OpenID Connect (optional) -----------------------------
# The whole feature stays disabled until ALL THREE values below are filled.
# Create them in Google Cloud Console -> APIs & Services -> Credentials.
# The redirect URI must match EXACTLY (scheme, host, port, trailing slash).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/google/callback

# Secret used to HMAC the short-lived flow cookie (state + PKCE + nonce).
# Required in production whenever the Google variables above are set.
# Generate with: openssl rand -hex 32
OAUTH_COOKIE_SECRET=

# Optional: name of the flow cookie (defaults to sarhny_oauth_flow).
# OAUTH_COOKIE_NAME=sarhny_oauth_flow

# Lifetimes in milliseconds (defaults shown).
# OAUTH_FLOW_TTL_MS=600000        # state/PKCE/nonce bundle (10 min)
# OAUTH_HANDOFF_TTL_MS=60000      # one-time handoff code (60 s)

# Optional SPA landing page. When set, GET /api/v1/auth/google/callback does
# NOT return tokens as JSON: it redirects to this URL with `?handoff=<code>`
# and the SPA exchanges that code at POST /api/v1/auth/google/exchange.
# (client/ uses the /auth/google/callback route — keep them identical.)
OAUTH_REDIRECT_URL=http://localhost:5173/auth/google/callback

# Space/comma separated scopes (defaults shown).
# GOOGLE_SCOPES=openid,email,profile
# Consent screen prompt: select_account | consent | none
# GOOGLE_PROMPT=select_account
