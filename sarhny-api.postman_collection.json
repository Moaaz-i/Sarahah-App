    {
      "name": "05 Reports",
      "description": "Moderation. Anyone (anonymous or authenticated) can report; only admins can review.\n\nRate limited to `RATE_LIMIT_REPORT_MAX` (default 10) per salted fingerprint per day.",
      "item": [
        {
          "name": "Report a message",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/reports",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "reports"
              ]
            },
            "description": "**Works anonymously.** Auth is optional — a valid access token is attached as the reporter when present, otherwise the report is stored with no reporter identity.\n\n`reason` must be one of: `harassment`, `threats`, `hate_speech`, `spam`, `sexual_content`, `other`. `details` is optional, max 1000 chars.\n\nThe report comes back at `data.report` with its identifier as **`id`** (not `_id`) — copy that value into `{{reportId}}` for the admin review requests.\n\nDuplicate reports from the same source for the same message are rejected.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"messageId\": \"{{messageId}}\",\n  \"reason\": \"spam\",\n  \"details\": \"Repeated unsolicited links.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "List reports (admin)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/reports?status=pending&page=1&limit=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "reports"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "pending"
                },
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "20"
                }
              ]
            },
            "description": "**Requires the `admin` role.** Page/limit pagination (`limit` max 100). `status`: `pending`, `reviewed`, `resolved`, `rejected`. Non-admins get `403`."
          },
          "response": []
        },
        {
          "name": "Get a report (admin)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/reports/{{reportId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "reports",
                "{{reportId}}"
              ]
            },
            "description": "**Requires the `admin` role.** The report identifier is exposed as `data.report.id`."
          },
          "response": []
        },
        {
          "name": "Update report status (admin)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
