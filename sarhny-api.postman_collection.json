    {
      "name": "01 Auth",
      "description": "JWT auth: 15-minute HS256 access token + opaque refresh token (stored server-side as a SHA-256 hash, rotated on every use).\n\nRegister/login/refresh are rate limited to `RATE_LIMIT_AUTH_MAX` (default 20) per 15 minutes, so the same IP may be throttled while you test.",
      "item": [
        {
          "name": "Register",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "register"
              ]
            },
            "description": "Creates an account. Change `username` / `email` to unique values before sending (a repeat answers `409`). `role` is always forced to `user` server-side — it can never be supplied here.\n\nPassword policy: 8-72 chars with at least one letter and one number.\n\nOn success the response variables `accessToken`, `refreshToken`, `userId` and `username` are stored automatically.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Sar7ny Demo\",\n  \"username\": \"demo_user\",\n  \"email\": \"demo@example.com\",\n  \"password\": \"Password123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body && body.data) {",
                  "    if (body.data.accessToken) pm.collectionVariables.set('accessToken', body.data.accessToken);",
                  "    if (body.data.refreshToken) pm.collectionVariables.set('refreshToken', body.data.refreshToken);",
                  "    if (body.data.user && body.data.user._id) pm.collectionVariables.set('userId', body.data.user._id);",
                  "    if (body.data.user && body.data.user.username) pm.collectionVariables.set('username', body.data.user.username);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "description": "`identifier` accepts either the username or the email.\n\nUnknown user and wrong password return byte-identical generic 401 responses (no account enumeration).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identifier\": \"demo_user\",\n  \"password\": \"Password123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body && body.data) {",
                  "    if (body.data.accessToken) pm.collectionVariables.set('accessToken', body.data.accessToken);",
                  "    if (body.data.refreshToken) pm.collectionVariables.set('refreshToken', body.data.refreshToken);",
                  "    if (body.data.user && body.data.user._id) pm.collectionVariables.set('userId', body.data.user._id);",
                  "    if (body.data.user && body.data.user.username) pm.collectionVariables.set('username', body.data.user.username);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh tokens",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/refresh",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "refresh"
              ]
            },
            "description": "Rotates the refresh token. The old one becomes invalid immediately; presenting it again is treated as token reuse and revokes the entire session chain.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body && body.data) {",
                  "    if (body.data.accessToken) pm.collectionVariables.set('accessToken', body.data.accessToken);",
                  "    if (body.data.refreshToken) pm.collectionVariables.set('refreshToken', body.data.refreshToken);",
                  "    if (body.data.user && body.data.user._id) pm.collectionVariables.set('userId', body.data.user._id);",
                  "    if (body.data.user && body.data.user.username) pm.collectionVariables.set('username', body.data.user.username);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Logout",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/logout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "logout"
              ]
            },
            "description": "Revokes the refresh token server-side. Requires a valid access token.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Current user",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "me"
              ]
            },
            "description": "Returns the authenticated user. 401 for a missing, expired, forged or disabled-account token."
          },
          "response": []
        }
      ]
    },
    {
      "name": "02 Google OAuth",
      "description": "Sign in with Google (OAuth 2.0 / OpenID Connect).\n\n**These endpoints are disabled until `GOOGLE_CLIENT_ID`, `GOOGLE_CLIENT_SECRET` and `GOOGLE_REDIRECT_URI` are all set** — otherwise they answer `400 OAUTH_NOT_CONFIGURED`.\n\nThe flow is browser-driven: `GET /` sets a signed HttpOnly flow cookie (`state` + PKCE `code_verifier` + `nonce`) and 302s to accounts.google.com, which redirects back to `/callback`. Two response modes:\n\n- **JSON (default)** — the callback replies with the token pair directly.\n- **Redirect** — set `OAUTH_REDIRECT_URL` and the callback 302s to your SPA with a one-time `handoff` code, redeemed by `POST /exchange`. Tokens are never placed in a URL.\n\nSee README section 10 for the Google Cloud Console setup and the exact redirect URI to register.",
      "item": [
        {
          "name": "Start sign-in flow",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/google?login_hint=demo@example.com",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "google"
              ],
              "query": [
                {
                  "key": "login_hint",
                  "value": "demo@example.com"
                }
              ]
            },
            "description": "**Open this in a browser, not in Postman.**\n\nReturns `302` to accounts.google.com with `state`, `code_challenge` (S256) and `nonce` in the query, plus the `sarhny_oauth_flow` cookie (`HttpOnly; SameSite=Lax; Path=/api/v1/auth/google`).\n\nA `redirect_uri` supplied in the query is ignored — it always comes from the environment."
          },
          "response": []
        },
        {
          "name": "Callback (called by Google)",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/google/callback?code={{googleCode}}&state={{oauthState}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "google",
                "callback"
              ],
              "query": [
                {
                  "key": "code",
                  "value": "{{googleCode}}"
                },
                {
                  "key": "state",
                  "value": "{{oauthState}}"
                }
              ]
            },
            "description": "**Only Google calls this** — the browser arrives here as part of the redirect chain.\n\nVerifies the signed flow cookie against `state` (CSRF), checks the `iss` hint, exchanges the code server-side with the stored PKCE verifier, and verifies the ID token (signature, issuer, audience, expiry, nonce) using `google-auth-library`.\n\nFailure codes: `OAUTH_STATE_MISMATCH` (400), `OAUTH_STATE_EXPIRED` (400), `OAUTH_ACCESS_DENIED` (400), `OAUTH_CODE_EXCHANGE_FAILED` (401), `OAUTH_ID_TOKEN_INVALID` (401), `OAUTH_EMAIL_NOT_VERIFIED` (401), `OAUTH_ACCOUNT_CONFLICT` (409), `OAUTH_ALREADY_LINKED` (409).\n\nThe flow cookie is cleared on every attempt, so a replayed callback fails."
          },
          "response": []
        },
        {
          "name": "Exchange handoff code",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/google/exchange",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "google",
                "exchange"
              ]
            },
            "description": "Only used when `OAUTH_REDIRECT_URL` is set. The code is single-use, stored as a SHA-256 hash and expires after `OAUTH_HANDOFF_TTL_MS` (60s by default).\n\nA link-purpose handoff returns `{linked: true}` **without** minting a new token pair — the caller is already authenticated. Unknown/reused codes return `401 OAUTH_HANDOFF_INVALID`.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"handoff\": \"{{handoff}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Start linking Google",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/google/link",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "google",
                "link"
              ]
            },
            "description": "Returns `{authorizationUrl}` for the browser to open; the flow cookie is set on this reply.\n\nLinking is **explicit only** — a Google identity whose verified email matches an existing password account is never linked automatically (`409 OAUTH_ACCOUNT_CONFLICT`).\n\nThe body is `.strict()`: sending `role`, `isVerified` or any unknown field returns `400 VALIDATION_ERROR`.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"login_hint\": \"demo@example.com\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "List linked providers",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/google/links",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "google",
                "links"
              ]
            },
            "description": "Returns `{links, hasPassword}`. `hasPassword` is what guards unlinking."
          },
          "response": []
        },
        {
          "name": "Unlink Google",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/google/link",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "google",
                "link"
              ]
            },
            "description": "Removed with `400 OAUTH_LAST_LOGIN_METHOD` when the account has no local password (lockout prevention), and `400 OAUTH_NOT_LINKED` when there is nothing to unlink."
          },
          "response": []
        }
      ]
    },
    {
      "name": "03 Users",
      "description": "Self-service routes plus the public profile.",
      "item": [
        {
          "name": "Update own profile",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/users/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "users",
                "me"
              ]
            },
            "description": "Only `name`, `bio` and `avatar` are accepted (`avatar` must be an http(s) URL or empty). `role`, `isActive`, `isVerified` and `username` are rejected with `400 VALIDATION_ERROR`. Sending an empty body is also rejected.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Sar7ny Demo\",\n  \"bio\": \"Testing the API\",\n  \"avatar\": \"\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Change password",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/users/me/password",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "users",
                "me",
                "password"
              ]
            },
            "description": "`currentPassword` is required for any account that already has a password. Omit it for a Google-only account that never had one — such callers are confirmed by their session alone; an empty string is rejected with 400 rather than treated as omitted. On success every other refresh token for the account is revoked (the session that made the change is kept).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentPassword\": \"Password123\",\n  \"newPassword\": \"NewPassword123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Delete own account",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "DELETE",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/users/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "users",
                "me"
              ]
            },
            "description": "Soft delete: `deletedAt` is set, sessions are revoked, and the account is wiped after `DELETED_ACCOUNT_RETENTION_DAYS` (30 by default). Response is generic. `password` is required for any account that already has one; omit it for a Google-only account.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"password\": \"Password123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Public profile",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/users/{{username}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "users",
                "{{username}}"
              ]
            },
            "description": "No authentication. Returns the public view only (username, name, bio, avatar, createdAt) — never the email, role or account status. 404 for missing or disabled accounts."
          },
          "response": []
        }
      ]
    },
    {
      "name": "04 Messages",
      "description": "Anonymous sending (the Message schema has **no sender field** — identity, IP and user agent are never persisted) plus the recipient's inbox.\n\nSending is rate limited to `RATE_LIMIT_MESSAGE_MAX` (default 10) per recipient per day.",
      "item": [
        {
          "name": "Send an anonymous message",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/messages/{{recipientUsername}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "messages",
                "{{recipientUsername}}"
              ]
            },
            "description": "**Public and anonymous.** No access token required; supplying one does not record it.\n\nThe recipient username comes from the path (`{{recipientUsername}}`). Content is 1-2000 chars.\n\nThe response is only `{sent: true}` — **no message id is returned**, on purpose: an anonymous send must not hand the sender a handle into someone's inbox. Run *List my inbox* as the recipient and copy `data.messages[0]._id` into `{{messageId}}` for the requests below.\n\nReturns the same generic 404 whether the recipient does not exist or has closed their inbox, so usernames cannot be probed.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"content\": \"Hello from Postman — this is sent anonymously.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "List my inbox",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/messages?limit=20&isRead=false&isArchived=false",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "messages"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "20"
                },
                {
                  "key": "isRead",
                  "value": "false"
                },
                {
                  "key": "isArchived",
                  "value": "false"
                }
              ]
            },
            "description": "**Cursor pagination** (not page/number). Drop `cursor` for the first page, then pass `data.nextCursor` from the previous response. `limit` is 1-50. `isRead` / `isArchived` are optional booleans.\n\nMessages are at `data.messages[]`; copy `data.messages[0]._id` into `{{messageId}}` (an anonymous send never returns the id itself)."
          },
          "response": []
        },
        {
