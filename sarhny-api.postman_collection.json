    {
      "name": "06 Password",
      "description": "One-time reset flow. **The response is always a generic 200** whether or not the email exists, so this endpoint cannot be used to discover accounts.\n\nRate limited to `RATE_LIMIT_PASSWORD_MAX` (default 5) per 15 minutes.",
      "item": [
        {
          "name": "Forgot password",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/password/forgot",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "password",
                "forgot"
              ]
            },
            "description": "**Disabled.** Answers `503 PASSWORD_RESET_DISABLED` for every caller — existing account or not, Google or local — because there is no delivery channel left to send a link (email was removed from the project). Identical status and body either way, so it cannot be used to discover accounts. See README §11.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"demo@example.com\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Reset password",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/password/reset",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "password",
                "reset"
              ]
            },
            "description": "The token is single-use, stored hashed and validated against `expiresAt` + `usedAt` (MongoDB's TTL sweep is not trusted on its own because it is not immediate).\n\nOn success every refresh token for the account is revoked, forcing a re-login everywhere.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{resetToken}}\",\n  \"newPassword\": \"BrandNew123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        }
      ]
