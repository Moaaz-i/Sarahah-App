                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "reports",
                "{{reportId}}",
                "status"
              ]
            },
            "description": "**Requires the `admin` role.** Every change writes an `AuditLog` entry. `status` must be one of: `pending`, `reviewed`, `resolved`, `rejected`.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"reviewed\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        }
      ]
